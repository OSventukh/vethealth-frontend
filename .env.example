# Backend API base URL (required — routes.ts throws if unset)
NEXT_PUBLIC_API_SERVER=http://localhost:5000
NEXT_PUBLIC_IMAGE_SERVER=http://localhost:5000

# Public site URL (used for metadataBase and admin sign-in/out redirects)
CLIENT_URL=http://localhost:3000

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google Analytics (reporting API + gtag)
GOOGLE_ANALYTICS_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
GA_PROPERTY_ID=

# Google AdSense — leave unset to disable the AdSense script entirely
# (ads are currently not used; set the publisher id to re-enable)
#ADSENSE_PUBLISHER_ID=

# CRO/AB-testing optimizer script (local copy at optimize.vethealth.com.ua) —
# set to "true" ONLY on staging, where it's used as a testbed; keep unset in
# production
#OPTIMIZER_ENABLED=true
